{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campus CMS Desktop",
  "version": "1.0.0",
  "identifier": "edu.institution.campus",
  "build": {
    "beforeDevCommand": "pnpm --filter @campus/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @campus/web build",
    "frontendDist": "../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "Campus Management System",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
