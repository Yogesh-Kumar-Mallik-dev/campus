// ------------------------------------------------------------------------------
// Multi-Tenant Partition Anchor
// ------------------------------------------------------------------------------

model Tenant {
  id                 String                       @id @default(uuid(7))
  slug               String                       @unique
  name               String
  domain             String?                      @unique
  isActive           Boolean                      @default(true) @map("is_active")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  users              User[]
  roles              Role[]
  sessions           Session[]
  auditLogs          AuditLog[]
  auditCheckpoints   AuditVerificationCheckpoint[]
  departments        AcademicDepartment[]
  programs           AcademicProgram[]
  cohorts            CohortBatch[]
  applicants         OnboardingApplicant[]
  documents          OnboardingDocument[]
  students           StudentProfile[]
  staffProfiles      StaffProfile[]
  sequenceCounters   IdentitySequenceCounter[]
  courseSubjects     CourseSubject[]
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  medicalLeaves      MedicalLeaveApplication[]
  feeStructures      FeeStructure[]
  studentInvoices    StudentInvoice[]
  paymentTransactions PaymentTransaction[]
  ledgerAccounts     LedgerAccount[]
  ledgerEntries      LedgerEntry[]
  notices            CampusNotice[]
  noticeAcknowledgements NoticeAcknowledgement[]
  hostelBlocks       HostelBlock[]
  hostelRooms        HostelRoom[]
  hostelBeds         HostelBed[]
  hostelAllocations  HostelBedAllocation[]
  hostelGatePasses   HostelGatePass[]
  hostelIncidents    HostelIncidentLog[]
  messHalls          MessHall[]
  messMenuItems      MessMenuItem[]
  messSubscriptions  MessSubscription[]
  diningTokens       MessDiningToken[]
  messRebates        MessRebateApplication[]
  messFeedbacks      MessMealFeedback[]
  libraryBooks       LibraryBook[]
  libraryBookCopies  LibraryBookCopy[]
  libraryBorrows     LibraryBorrowRecord[]
  libraryReservations LibraryReservation[]
  ebookAccesses      LibraryEbookAccess[]
  studyCourses       StudyCourse[]
  studyMaterials     StudyMaterial[]
  studyAssignments   StudyAssignment[]
  studySubmissions   StudySubmission[]
  mentorAllocations  MentorAllocation[]
  mentorshipSessions MentorshipSession[]
  studentProgress    StudentAcademicProgress[]
  atRiskAlerts       MentorshipAtRiskAlert[]

  @@map("tenants")
}

// ------------------------------------------------------------------------------
// Core User Identity Model
// ------------------------------------------------------------------------------

model User {
  id                     String       @id @default(uuid(7))
  tenantId               String       @map("tenant_id")
  tier                   AccountTier  @default(USER)
  username               String
  email                  String
  emailNormalized        String       @map("email_normalized")
  passwordHash           String       @map("password_hash")
  status                 UserStatus   @default(ACTIVE)
  failedLoginAttempts    Int          @default(0) @map("failed_login_attempts")
  lockoutUntil           DateTime?    @map("lockout_until")
  lastLoginAt            DateTime?    @map("last_login_at")
  
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles              UserRole[]
  sessions               Session[]
  tokenFamilies          RefreshTokenFamily[]
  mfaEnrollment          MFAEnrollment?
  auditLogs              AuditLog[]
  studentProfile         StudentProfile?
  staffProfile           StaffProfile?
  reviewedApplicants     OnboardingApplicant[] @relation("ApplicantReviewer")
  verifiedDocuments      OnboardingDocument[]  @relation("DocumentVerifier")
  approvedMedicalLeaves  MedicalLeaveApplication[] @relation("MedicalLeaveApprover")
  authoredNotices        CampusNotice[]        @relation("NoticeAuthor")
  noticeAcknowledgements NoticeAcknowledgement[]
  wardenBlocks           HostelBlock[]         @relation("WardenBlock")
  approvedGatePasses     HostelGatePass[]      @relation("GatePassApprover")
  loggedIncidents        HostelIncidentLog[]   @relation("IncidentLogger")
  managedMessHalls       MessHall[]            @relation("MessManager")
  approvedMessRebates    MessRebateApplication[] @relation("MessRebateApprover")
  issuedBorrows          LibraryBorrowRecord[] @relation("BorrowIssuer")
  createdCourses         StudyCourse[]         @relation("CourseInstructor")
  gradedSubmissions      StudySubmission[]     @relation("SubmissionGrader")

  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  @@unique([tenantId, emailNormalized])
  @@unique([tenantId, username])
  @@index([tenantId, status])
  @@map("users")
}

// ------------------------------------------------------------------------------
// Roles & Functional Personas
// ------------------------------------------------------------------------------

model Role {
  id          String           @id @default(uuid(7))
  tenantId    String           @map("tenant_id")
  key         String           // e.g. "student", "faculty", "warden", "librarian", "admin"
  name        String           // Human-readable: "Faculty Member"
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePerms   RolePermission[]
  userRoles   UserRole[]

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

// ------------------------------------------------------------------------------
// Granular Capability Permissions
// ------------------------------------------------------------------------------

model Permission {
  id          String           @id @default(uuid(7))
  key         String           @unique // e.g. "hostel:gatepass:approve", "mess:menu:update"
  domain      String           // e.g. "hostel", "mess", "academics", "auth"
  description String
  
  rolePerms   RolePermission[]

  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([domain])
  @@map("permissions")
}

// ------------------------------------------------------------------------------
// Role-Permission Explicit Mapping
// ------------------------------------------------------------------------------

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// User-Role Persona Assignment (with Domain/Dept/Hostel Scope)
// ------------------------------------------------------------------------------

model UserRole {
  id          String   @id @default(uuid(7))
  userId      String   @map("user_id")
  roleId      String   @map("role_id")
  
  // Optional domain scope (e.g. "dept_mechanical", "hostel_block_b", "campus_wide")
  scopeType   String?  @map("scope_type")
  scopeId     String?  @map("scope_id")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId, scopeId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ------------------------------------------------------------------------------
// Active Session State
// ------------------------------------------------------------------------------

model Session {
  id                String              @id @default(uuid(7))
  userId            String              @map("user_id")
  tenantId          String              @map("tenant_id")
  tokenFamilyId     String              @map("token_family_id")
  currentTokenHash  String              @map("current_token_hash")
  ipAddress         String?             @map("ip_address")
  userAgent         String?             @map("user_agent")
  deviceFingerprint String?             @map("device_fingerprint")
  expiresAt         DateTime            @map("expires_at")
  revokedAt         DateTime?           @map("revoked_at")
  revokedReason     String?             @map("revoked_reason")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenFamily       RefreshTokenFamily  @relation(fields: [tokenFamilyId], references: [familyId], onDelete: Cascade)

  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([userId, tenantId])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@map("sessions")
}

// ------------------------------------------------------------------------------
// Refresh Token Family (Single-Use Rotation & Replay Attack Defense)
// ------------------------------------------------------------------------------

model RefreshTokenFamily {
  familyId         String    @id @default(uuid(7)) @map("family_id")
  userId           String    @map("user_id")
  activeTokenHash  String    @map("active_token_hash")
  rotationCount    Int       @default(0) @map("rotation_count")
  isCompromised    Boolean   @default(false) @map("is_compromised")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         Session[]

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("refresh_token_families")
}

// ------------------------------------------------------------------------------
// Multi-Factor Authentication (TOTP & Backup Codes)
// ------------------------------------------------------------------------------

model MFAEnrollment {
  userId             String    @id @map("user_id")
  mfaType            MFAType   @default(TOTP) @map("mfa_type")
  secretEncrypted    String    @map("secret_encrypted")
  backupCodesHashed  String?   @map("backup_codes_hashed")
  isVerified         Boolean   @default(false) @map("is_verified")
  enrolledAt         DateTime  @default(now()) @map("enrolled_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_enrollments")
}

// ==============================================================================
// Subsystem: Rank 2 - Central Audit & Compliance System (audit)
// Immutable, Tamper-Evident Ledger with SHA-256 Hash Chaining
// ==============================================================================

model AuditLog {
  id           String         @id @default(uuid(7))
  tenantId     String         @map("tenant_id")
  actorId      String?        @map("actor_id")
  actorType    AuditActorType @default(USER) @map("actor_type")
  actorRole    String?        @map("actor_role")
  action       String         // e.g. "auth:login:success", "auth:token:breach_detected", "user:create"
  resourceType String         @map("resource_type") // e.g. "user", "session", "invoice", "student"
  resourceId   String?        @map("resource_id")
  status       AuditStatus    @default(SUCCESS)
  statusCode   Int?           @map("status_code")
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  traceId      String?        @map("trace_id")
  metadata     Json?
  changes      Json?          // Before / after state diff
  prevHash     String?        @map("prev_hash")
  hash         String         // SHA-256 hash of (id + tenantId + actorId + action + resource + prevHash)
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorId])
  @@index([tenantId, action])
  @@index([traceId])
  @@map("audit_logs")
}

model AuditVerificationCheckpoint {
  id                 String   @id @default(uuid(7))
  tenantId           String   @map("tenant_id")
  startAuditId       String   @map("start_audit_id")
  endAuditId         String   @map("end_audit_id")
  recordCount        Int      @map("record_count")
  headHash           String   @map("head_hash")
  isVerified         Boolean  @map("is_verified")
  verifiedAt         DateTime @default(now()) @map("verified_at")
  verificationErrors Json?    @map("verification_errors")

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, verifiedAt])
  @@map("audit_verification_checkpoints")
}

// ==============================================================================
// Subsystem: Rank 3 - Student & Staff Registration System (onboarding)
// KYC Workflows, Deterministic Roll Numbers/Employee IDs & Cohort Provisioning
// ==============================================================================

// ------------------------------------------------------------------------------
// Academic Structure (Departments & Programs)
// ------------------------------------------------------------------------------

model AcademicDepartment {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  code        String   // e.g. "CSE", "ECE", "MECH", "ADMIN"
  name        String   // e.g. "Computer Science & Engineering"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programs    AcademicProgram[]
  applicants  OnboardingApplicant[]
  staff       StaffProfile[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("academic_departments")
}

model AcademicProgram {
  id             String     @id @default(uuid(7))
  tenantId       String     @map("tenant_id")
  departmentId   String     @map("department_id")
  code           String     // e.g. "BTECH_CSE", "MTECH_AI"
  name           String     // e.g. "Bachelor of Technology in Computer Science"
  degreeType     DegreeType @default(UG) @map("degree_type")
  durationYears  Int        @default(4) @map("duration_years")
  totalSemesters Int        @default(8) @map("total_semesters")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     AcademicDepartment  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  cohorts        CohortBatch[]
  applicants     OnboardingApplicant[]
  students       StudentProfile[]
  subjects       CourseSubject[]
  feeStructures  FeeStructure[]

  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@map("academic_programs")
}

model CohortBatch {
  id              String          @id @default(uuid(7))
  tenantId        String          @map("tenant_id")
  programId       String          @map("program_id")
  academicYear    String          @map("academic_year") // e.g. "2026-2027"
  startYear       Int             @map("start_year")    // 2026
  endYear         Int             @map("end_year")      // 2030
  section         String          @default("A")         // "A", "B", "C"
  maxCapacity     Int             @default(60) @map("max_capacity")
  currentEnrolled Int             @default(0) @map("current_enrolled")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program            AcademicProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  students           StudentProfile[]
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]

  @@unique([tenantId, programId, academicYear, section])
  @@index([tenantId, programId])
  @@map("cohort_batches")
}

// ------------------------------------------------------------------------------
// Applicant KYC Record & Verification Queue
// ------------------------------------------------------------------------------

model OnboardingApplicant {
  id                       String           @id @default(uuid(7))
  tenantId                 String           @map("tenant_id")
  type                     OnboardingType   @default(STUDENT)
  status                   OnboardingStatus @default(DRAFT)
  
  // Personal Details
  firstName                String           @map("first_name")
  lastName                 String           @map("last_name")
  email                    String
  phone                    String
  dateOfBirth              String           @map("date_of_birth") // YYYY-MM-DD
  gender                   Gender           @default(MALE)
  bloodGroup               String?          @map("blood_group")
  nationality              String           @default("Indian")
  
  // Emergency Contact
  emergencyContactName     String           @map("emergency_contact_name")
  emergencyContactPhone    String           @map("emergency_contact_phone")
  emergencyContactRelation String           @map("emergency_contact_relation")
  
  // Address
  addressLine1             String           @map("address_line1")
  addressLine2             String?          @map("address_line2")
  city                     String
  state                    String
  postalCode               String           @map("postal_code")
  country                  String           @default("India")
  
  // Academic / Employment Targeting
  programId                String?          @map("program_id")
  departmentId             String?          @map("department_id")
  academicYear             String           @map("academic_year") // e.g. "2026-2027"
  targetDesignation        String?          @map("target_designation") // For Staff/Faculty
  
  // Guardian Information (For Students)
  guardianName             String?          @map("guardian_name")
  guardianEmail            String?          @map("guardian_email")
  guardianPhone            String?          @map("guardian_phone")
  guardianRelation         String?          @map("guardian_relation")
  
  // Reviewer / Audit state
  reviewerId               String?          @map("reviewer_id")
  reviewedAt               DateTime?        @map("reviewed_at")
  rejectionReason          String?          @map("rejection_reason")
  
  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program                  AcademicProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  department               AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reviewer                 User?            @relation("ApplicantReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  documents                OnboardingDocument[]
  studentProfile           StudentProfile?
  staffProfile             StaffProfile?

  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, email])
  @@map("onboarding_applicants")
}

// ------------------------------------------------------------------------------
// Document Attachments
// ------------------------------------------------------------------------------

model OnboardingDocument {
  id              String         @id @default(uuid(7))
  tenantId        String         @map("tenant_id")
  applicantId     String         @map("applicant_id")
  documentType    DocumentType   @map("document_type")
  fileKey         String         @map("file_key")
  fileName        String         @map("file_name")
  fileSize        Int            @map("file_size")
  mimeType        String         @map("mime_type")
  status          DocumentStatus @default(PENDING_REVIEW)
  rejectionReason String?        @map("rejection_reason")
  verifiedById    String?        @map("verified_by_id")
  verifiedAt      DateTime?      @map("verified_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant       OnboardingApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  verifiedBy      User?          @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([applicantId, documentType])
  @@index([tenantId, applicantId])
  @@map("onboarding_documents")
}

// ------------------------------------------------------------------------------
// Enrolled Institutional Profiles
// ------------------------------------------------------------------------------

model StudentProfile {
  id                 String          @id @default(uuid(7))
  tenantId           String          @map("tenant_id")
  userId             String          @unique @map("user_id")
  applicantId        String          @unique @map("applicant_id")
  rollNumber         String          @map("roll_number")
  registrationNumber String          @map("registration_number")
  programId          String          @map("program_id")
  cohortId           String          @map("cohort_id")
  currentSemester    Int             @default(1) @map("current_semester")
  enrollmentDate     DateTime        @default(now()) @map("enrollment_date")

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicant          OnboardingApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  program            AcademicProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  cohort             CohortBatch     @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  attendanceRecords  AttendanceRecord[]
  medicalLeaves      MedicalLeaveApplication[]
  invoices           StudentInvoice[]
  paymentTransactions PaymentTransaction[]
  hostelAllocations  HostelBedAllocation[]
  gatePasses         HostelGatePass[]
  hostelIncidents    HostelIncidentLog[]
  messSubscriptions  MessSubscription[]
  diningTokens       MessDiningToken[]
  messRebates        MessRebateApplication[]
  messFeedbacks      MessMealFeedback[]
  libraryBorrows     LibraryBorrowRecord[]
  libraryReservations LibraryReservation[]
  ebookAccesses      LibraryEbookAccess[]
  assignmentSubmissions StudySubmission[]
  peerReviewsGiven   StudyPeerReview[]   @relation("PeerReviewer")
  mentorAllocations  MentorAllocation[]
  academicProgress   StudentAcademicProgress[]
  atRiskAlerts       MentorshipAtRiskAlert[]

  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, rollNumber])
  @@unique([tenantId, registrationNumber])
  @@index([tenantId, programId])
  @@index([tenantId, cohortId])
  @@map("student_profiles")
}

model StaffProfile {
  id                 String             @id @default(uuid(7))
  tenantId           String             @map("tenant_id")
  userId             String             @unique @map("user_id")
  applicantId        String             @unique @map("applicant_id")
  employeeId         String             @map("employee_id")
  departmentId       String             @map("department_id")
  designation        String             // e.g. "Assistant Professor", "Senior Warden", "Catalog Librarian"
  roleKey            String             @map("role_key") // e.g. "faculty", "warden", "librarian", "admin"
  joiningDate        DateTime           @default(now()) @map("joining_date")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicant          OnboardingApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  department         AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]
  menteeAllocations  MentorAllocation[]

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId])
  @@index([tenantId, departmentId])
  @@map("staff_profiles")
}

// ------------------------------------------------------------------------------
// Deterministic Atomic Sequence Reservation Engine
// ------------------------------------------------------------------------------

model IdentitySequenceCounter {
  id           String   @id @default(uuid(7))
  tenantId     String   @map("tenant_id")
  sequenceType String   @map("sequence_type") // e.g. "ROLL_NUMBER", "EMPLOYEE_ID"
  prefix       String   // e.g. "2026-BTECH_CSE", "EMP-CSE"
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sequenceType, prefix])
  @@map("identity_sequence_counters")
}

// ==============================================================================
// Subsystem: Rank 4 - Attendance Management System (attendance)
// Multi-Mode Roll Call, Threshold Tracking (<75%) & Medical Condonation
// ==============================================================================

model CourseSubject {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  programId   String   @map("program_id")
  code        String   // e.g. "CS301", "MA101"
  name        String   // e.g. "Data Structures & Algorithms"
  credits     Int      @default(4)
  semester    Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program     AcademicProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  slots       TimetableSlot[]
  sessions    AttendanceSession[]

  @@unique([tenantId, programId, code])
  @@index([tenantId, programId])
  @@map("course_subjects")
}

model TimetableSlot {
  id           String    @id @default(uuid(7))
  tenantId     String    @map("tenant_id")
  subjectId    String    @map("subject_id")
  cohortId     String    @map("cohort_id")
  facultyId    String    @map("faculty_id") // StaffProfile ID
  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time") // "09:00"
  endTime      String    @map("end_time")   // "10:00"
  roomCode     String    @map("room_code")  // "LH-101"
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject      CourseSubject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cohort       CohortBatch       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  faculty      StaffProfile      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  sessions     AttendanceSession[]

  @@index([tenantId, cohortId, dayOfWeek])
  @@index([tenantId, facultyId])
  @@map("timetable_slots")
}

model AttendanceSession {
  id            String                  @id @default(uuid(7))
  tenantId      String                  @map("tenant_id")
  slotId        String?                 @map("slot_id")
  subjectId     String                  @map("subject_id")
  facultyId     String                  @map("faculty_id") // StaffProfile ID
  cohortId      String                  @map("cohort_id")
  sessionDate   String                  @map("session_date") // YYYY-MM-DD
  startTime     String                  @map("start_time")   // "09:00"
  endTime       String                  @map("end_time")     // "10:00"
  mode          AttendanceMode          @default(MANUAL_FACULTY)
  status        AttendanceSessionStatus @default(SCHEDULED)
  openedAt      DateTime?               @map("opened_at")
  lockedAt      DateTime?               @map("locked_at")
  totalStudents Int                     @default(0) @map("total_students")
  presentCount  Int                     @default(0) @map("present_count")
  absentCount   Int                     @default(0) @map("absent_count")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot          TimetableSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)
  subject       CourseSubject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty       StaffProfile            @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  cohort        CohortBatch             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  records       AttendanceRecord[]

  @@unique([tenantId, cohortId, subjectId, sessionDate, startTime])
  @@index([tenantId, facultyId, sessionDate])
  @@index([tenantId, cohortId, sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String                 @id @default(uuid(7))
  tenantId    String                 @map("tenant_id")
  sessionId   String                 @map("session_id")
  studentId   String                 @map("student_id") // StudentProfile ID
  status      AttendanceRecordStatus @default(PRESENT)
  remarks     String?
  markedAt    DateTime               @default(now()) @map("marked_at")
  deviceId    String?                @map("device_id")
  latitude    Float?
  longitude   Float?
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     AttendanceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId, status])
  @@index([sessionId])
  @@map("attendance_records")
}

model MedicalLeaveApplication {
  id              String             @id @default(uuid(7))
  tenantId        String             @map("tenant_id")
  studentId       String             @map("student_id") // StudentProfile ID
  fromDate        String             @map("from_date") // YYYY-MM-DD
  toDate          String             @map("to_date")   // YYYY-MM-DD
  reason          String
  certificateKey  String             @map("certificate_key")
  status          MedicalLeaveStatus @default(PENDING)
  approvedById    String?            @map("approved_by_id")
  approvedAt      DateTime?          @map("approved_at")
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy      User?              @relation("MedicalLeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, status])
  @@map("medical_leave_applications")
}

// ------------------------------------------------------------------------------
// Subsystem: Rank 5 - Central Payment & Billing System (billing)
// ------------------------------------------------------------------------------

model FeeStructure {
  id           String             @id @default(uuid(7))
  tenantId     String             @map("tenant_id")
  programId    String             @map("program_id")
  academicYear String             @map("academic_year") // "2026-2027"
  semester     Int
  name         String
  totalAmount  Int                @map("total_amount") // Smallest currency unit (cents/paise)
  currency     String             @default("INR")
  dueDate      String             @map("due_date")     // YYYY-MM-DD
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program      AcademicProgram    @relation(fields: [programId], references: [id], onDelete: Restrict)
  items        FeeStructureItem[]
  invoices     StudentInvoice[]

  @@unique([tenantId, programId, academicYear, semester])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String       @id @default(uuid(7))
  tenantId       String       @map("tenant_id")
  feeStructureId String       @map("fee_structure_id")
  category       FeeCategory
  name           String
  amount         Int
  isOptional     Boolean      @default(false) @map("is_optional")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
  @@map("fee_structure_items")
}

model StudentInvoice {
  id              String               @id @default(uuid(7))
  tenantId        String               @map("tenant_id")
  studentId       String               @map("student_id") // StudentProfile ID
  feeStructureId  String?              @map("fee_structure_id")
  invoiceNumber   String               @map("invoice_number") // e.g. INV-2026-000001
  academicYear    String               @map("academic_year")
  semester        Int
  subtotalAmount  Int                  @map("subtotal_amount")
  discountAmount  Int                  @default(0) @map("discount_amount")
  taxAmount       Int                  @default(0) @map("tax_amount")
  totalAmount     Int                  @map("total_amount")
  paidAmount      Int                  @default(0) @map("paid_amount")
  balanceAmount   Int                  @map("balance_amount")
  dueDate         String               @map("due_date")
  status          InvoiceStatus        @default(ISSUED)
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure    FeeStructure?        @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  transactions    PaymentTransaction[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId, status])
  @@map("student_invoices")
}

model InvoiceItem {
  id         String         @id @default(uuid(7))
  tenantId   String         @map("tenant_id")
  invoiceId  String         @map("invoice_id")
  category   FeeCategory
  name       String
  amount     Int
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  invoice    StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentTransaction {
  id               String          @id @default(uuid(7))
  tenantId         String          @map("tenant_id")
  invoiceId        String          @map("invoice_id")
  studentId        String          @map("student_id")
  transactionRef   String          @map("transaction_ref") // TXN-2026-000001
  gatewayName      String          @default("INTERNAL") @map("gateway_name")
  gatewayOrderId   String?         @map("gateway_order_id")
  gatewayPaymentId String?         @map("gateway_payment_id")
  amount           Int
  currency         String          @default("INR")
  method           PaymentMethod   @default(ONLINE_GATEWAY)
  status           PaymentStatus   @default(INITIATED)
  idempotencyKey   String?         @map("idempotency_key")
  receiptNumber    String?         @map("receipt_number") // REC-2026-000001
  failureReason    String?         @map("failure_reason")
  paidAt           DateTime?       @map("paid_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice          StudentInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student          StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ledgerEntries    LedgerEntry[]

  @@unique([tenantId, transactionRef])
  @@index([tenantId, invoiceId])
  @@index([tenantId, studentId])
  @@map("payment_transactions")
}

model LedgerAccount {
  id          String            @id @default(uuid(7))
  tenantId    String            @map("tenant_id")
  code        String            // "1000-CASH", "2000-AR", "4000-TUITION"
  name        String
  type        LedgerAccountType
  balance     Int               @default(0) // Running balance in smallest currency unit
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries     LedgerEntry[]

  @@unique([tenantId, code])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String              @id @default(uuid(7))
  tenantId      String              @map("tenant_id")
  transactionId String?             @map("transaction_id")
  accountId     String              @map("account_id")
  entryType     LedgerEntryType     @map("entry_type")
  amount        Int
  description   String
  postedAt      DateTime            @default(now()) @map("posted_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  account       LedgerAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId, postedAt])
  @@map("ledger_entries")
}

// ------------------------------------------------------------------------------
// Subsystem: Rank 6 - Notice & Announcement System (notices)
// ------------------------------------------------------------------------------

model CampusNotice {
  id              String                  @id @default(uuid(7))
  tenantId        String                  @map("tenant_id")
  authorId        String                  @map("author_id") // User ID
  title           String
  slug            String
  content         String
  category        NoticeCategory          @default(GENERAL)
  priority        NoticePriority          @default(NORMAL)
  status          NoticeStatus            @default(DRAFT)
  targetAudience  TargetAudience          @default(ALL) @map("target_audience")
  targetDeptId    String?                 @map("target_dept_id")
  targetProgramId String?                 @map("target_program_id")
  targetCohortId  String?                 @map("target_cohort_id")
  isPinned        Boolean                 @default(false) @map("is_pinned")
  publishAt       DateTime                @default(now()) @map("publish_at")
  expiresAt       DateTime?               @map("expires_at")
  viewCount       Int                     @default(0) @map("view_count")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author          User                    @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments     NoticeAttachment[]
  acknowledgements NoticeAcknowledgement[]

  @@unique([tenantId, slug])
  @@index([tenantId, category, status])
  @@index([tenantId, isPinned, publishAt])
  @@map("campus_notices")
}

model NoticeAttachment {
  id        String       @id @default(uuid(7))
  tenantId  String       @map("tenant_id")
  noticeId  String       @map("notice_id")
  fileName  String       @map("file_name")
  fileKey   String       @map("file_key")
  fileSize  Int          @map("file_size")
  mimeType  String       @map("mime_type")
  createdAt DateTime     @default(now()) @map("created_at")

  notice    CampusNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@map("notice_attachments")
}

model NoticeAcknowledgement {
  id             String       @id @default(uuid(7))
  tenantId       String       @map("tenant_id")
  noticeId       String       @map("notice_id")
  userId         String       @map("user_id")
  readAt         DateTime     @default(now()) @map("read_at")
  acknowledgedAt DateTime?    @map("acknowledged_at")
  deviceId       String?      @map("device_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notice         CampusNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([tenantId, userId])
  @@map("notice_acknowledgements")
}

// ------------------------------------------------------------------------------
// Subsystem: Rank 7 - Hostel Management System (hostel)
// ------------------------------------------------------------------------------

model HostelBlock {
  id           String              @id @default(uuid(7))
  tenantId     String              @map("tenant_id")
  name         String              // e.g. "Aryabhatta Block A"
  code         String              // e.g. "BH-A"
  gender       HostelGender        @default(MALE)
  totalFloors  Int                 @default(3) @map("total_floors")
  totalRooms   Int                 @default(60) @map("total_rooms")
  capacity     Int                 @default(120)
  wardenId     String?             @map("warden_id")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warden       User?               @relation("WardenBlock", fields: [wardenId], references: [id], onDelete: SetNull)
  rooms        HostelRoom[]
  gatePasses   HostelGatePass[]
  incidents    HostelIncidentLog[]

  @@unique([tenantId, code])
  @@index([tenantId, gender, isActive])
  @@map("hostel_blocks")
}

model HostelRoom {
  id                 String           @id @default(uuid(7))
  tenantId           String           @map("tenant_id")
  blockId            String           @map("block_id")
  roomNumber         String           @map("room_number") // e.g. "101", "204"
  floorNumber        Int              @default(1) @map("floor_number")
  roomType           HostelRoomType   @default(DOUBLE) @map("room_type")
  isAc               Boolean          @default(false) @map("is_ac")
  baseFeePerSemester Float            @default(25000) @map("base_fee_per_semester")
  status             HostelRoomStatus @default(AVAILABLE)
  maxBeds            Int              @default(2) @map("max_beds")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  block              HostelBlock      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  beds               HostelBed[]

  @@unique([blockId, roomNumber])
  @@index([tenantId, blockId, status])
  @@map("hostel_rooms")
}

model HostelBed {
  id          String                @id @default(uuid(7))
  tenantId    String                @map("tenant_id")
  roomId      String                @map("room_id")
  bedNumber   String                @map("bed_number") // e.g. "A-101-1"
  status      HostelBedStatus       @default(AVAILABLE)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room        HostelRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations HostelBedAllocation[]

  @@unique([roomId, bedNumber])
  @@index([tenantId, status])
  @@map("hostel_beds")
}

model HostelBedAllocation {
  id           String                 @id @default(uuid(7))
  tenantId     String                 @map("tenant_id")
  bedId        String                 @map("bed_id")
  studentId    String                 @map("student_id")
  academicYear String                 @map("academic_year") // e.g. "2026-2027"
  semester     Int                    @default(1)
  allocatedAt  DateTime               @default(now()) @map("allocated_at")
  vacatedAt    DateTime?              @map("vacated_at")
  status       HostelAllocationStatus @default(ALLOCATED)
  remarks      String?
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bed          HostelBed              @relation(fields: [bedId], references: [id], onDelete: Cascade)
  student      StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, status])
  @@index([tenantId, bedId, status])
  @@map("hostel_bed_allocations")
}

model HostelGatePass {
  id               String         @id @default(uuid(7))
  tenantId         String         @map("tenant_id")
  studentId        String         @map("student_id")
  blockId          String         @map("block_id")
  reason           String
  destination      String
  emergencyContact String         @map("emergency_contact")
  expectedOutAt    DateTime       @map("expected_out_at")
  expectedInAt     DateTime       @map("expected_in_at")
  actualOutAt      DateTime?      @map("actual_out_at")
  actualInAt       DateTime?      @map("actual_in_at")
  status           GatePassStatus @default(PENDING)
  approvedById     String?        @map("approved_by_id")
  rejectionReason  String?        @map("rejection_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  block            HostelBlock    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  approvedBy       User?          @relation("GatePassApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, status])
  @@index([tenantId, blockId, status])
  @@map("hostel_gate_passes")
}

model HostelIncidentLog {
  id           String             @id @default(uuid(7))
  tenantId     String             @map("tenant_id")
  studentId    String             @map("student_id")
  blockId      String             @map("block_id")
  wardenId     String             @map("warden_id")
  incidentType HostelIncidentType @map("incident_type")
  severity     IncidentSeverity   @default(LOW)
  title        String
  description  String
  actionTaken  String?            @map("action_taken")
  fineAmount   Float              @default(0) @map("fine_amount")
  resolvedAt   DateTime?          @map("resolved_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  block        HostelBlock        @relation(fields: [blockId], references: [id], onDelete: Cascade)
  warden       User               @relation("IncidentLogger", fields: [wardenId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([tenantId, blockId, incidentType])
  @@map("hostel_incident_logs")
}

// ------------------------------------------------------------------------------
// Subsystem: Rank 8 - Mess Management System (mess)
// ------------------------------------------------------------------------------

model MessHall {
  id           String             @id @default(uuid(7))
  tenantId     String             @map("tenant_id")
  name         String             // e.g. "North Campus Central Mess"
  code         String             // e.g. "MESS-NORTH"
  capacity     Int                @default(400)
  location     String             // e.g. "Behind Block A & B"
  catererName  String             @map("caterer_name")
  managerId    String?            @map("manager_id")
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager       User?              @relation("MessManager", fields: [managerId], references: [id], onDelete: SetNull)
  menuItems     MessMenuItem[]
  subscriptions MessSubscription[]
  diningTokens  MessDiningToken[]
  feedbacks     MessMealFeedback[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("mess_halls")
}

model MessMenuItem {
  id           String        @id @default(uuid(7))
  tenantId     String        @map("tenant_id")
  messHallId   String        @map("mess_hall_id")
  dayOfWeek    DayOfWeek     @map("day_of_week")
  mealType     MealType      @map("meal_type")
  dietCategory DietCategory  @default(VEG) @map("diet_category")
  title        String        // e.g. "Paneer Butter Masala, Dal Makhani, Rice, Roti, Gulab Jamun"
  description  String?
  calories     Int           @default(650)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messHall     MessHall      @relation(fields: [messHallId], references: [id], onDelete: Cascade)

  @@unique([messHallId, dayOfWeek, mealType, dietCategory])
  @@index([tenantId, messHallId, dayOfWeek])
  @@map("mess_menu_items")
}

model MessSubscription {
  id             String                 @id @default(uuid(7))
  tenantId       String                 @map("tenant_id")
  studentId      String                 @map("student_id")
  messHallId     String                 @map("mess_hall_id")
  planType       MessPlanType           @default(SEMESTER) @map("plan_type")
  dietPreference DietCategory           @default(VEG) @map("diet_preference")
  startDate      DateTime               @map("start_date")
  endDate        DateTime               @map("end_date")
  status         MessSubscriptionStatus @default(ACTIVE)
  monthlyFee     Float                  @default(4500) @map("monthly_fee")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messHall       MessHall               @relation(fields: [messHallId], references: [id], onDelete: Cascade)
  rebates        MessRebateApplication[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, messHallId, status])
  @@map("mess_subscriptions")
}

model MessDiningToken {
  id             String            @id @default(uuid(7))
  tenantId       String            @map("tenant_id")
  studentId      String            @map("student_id")
  messHallId     String            @map("mess_hall_id")
  mealType       MealType          @map("meal_type")
  tokenCode      String            @unique @map("token_code") // Secure QR code token
  mealDate       String            @map("meal_date") // YYYY-MM-DD
  status         DiningTokenStatus @default(GENERATED)
  redeemedAt     DateTime?         @map("redeemed_at")
  deviceReaderId String?           @map("device_reader_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messHall       MessHall          @relation(fields: [messHallId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, mealType, mealDate])
  @@index([tenantId, messHallId, mealDate, mealType])
  @@map("mess_dining_tokens")
}

model MessRebateApplication {
  id                String           @id @default(uuid(7))
  tenantId          String           @map("tenant_id")
  studentId         String           @map("student_id")
  subscriptionId    String           @map("subscription_id")
  fromDate          DateTime         @map("from_date")
  toDate            DateTime         @map("to_date")
  totalDays         Int              @map("total_days")
  dailyRate         Float            @default(150) @map("daily_rate")
  totalRebateAmount Float            @map("total_rebate_amount")
  reason            String
  gatePassId        String?          @map("gate_pass_id")
  status            MessRebateStatus @default(PENDING)
  approvedById      String?          @map("approved_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription      MessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  approvedBy        User?            @relation("MessRebateApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, status])
  @@map("mess_rebate_applications")
}

model MessMealFeedback {
  id            String         @id @default(uuid(7))
  tenantId      String         @map("tenant_id")
  studentId     String         @map("student_id")
  messHallId    String         @map("mess_hall_id")
  mealDate      String         @map("meal_date") // YYYY-MM-DD
  mealType      MealType       @map("meal_type")
  foodRating    Int            @default(5) @map("food_rating") // 1-5
  hygieneRating Int            @default(5) @map("hygiene_rating") // 1-5
  comments      String?
  createdAt     DateTime       @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messHall      MessHall       @relation(fields: [messHallId], references: [id], onDelete: Cascade)

  @@index([tenantId, messHallId, mealDate])
  @@map("mess_meal_feedbacks")
}

// ------------------------------------------------------------------------------
// Subsystem: Rank 9 - E-Library System (library)
// ------------------------------------------------------------------------------

model LibraryBook {
  id              String         @id @default(uuid(7))
  tenantId        String         @map("tenant_id")
  isbn            String
  title           String
  author          String
  publisher       String
  edition         String?
  category        BookCategory   @default(GENERAL)
  totalCopies     Int            @default(1) @map("total_copies")
  availableCopies Int            @default(1) @map("available_copies")
  shelfLocation   String         @map("shelf_location") // e.g. "Rack 4, Bay B"
  ebookKey        String?        @map("ebook_key")
  ebookFormat     String?        @map("ebook_format") // PDF, EPUB
  ebookSize       Int?           @map("ebook_size")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies          LibraryBookCopy[]
  reservations    LibraryReservation[]
  ebookAccesses   LibraryEbookAccess[]

  @@unique([tenantId, isbn])
  @@index([tenantId, category])
  @@index([tenantId, title])
  @@map("library_books")
}

model LibraryBookCopy {
  id              String         @id @default(uuid(7))
  tenantId        String         @map("tenant_id")
  bookId          String         @map("book_id")
  accessionNumber String         @map("accession_number") // e.g. "LIB-ACC-001042"
  barcode         String
  status          BookCopyStatus @default(AVAILABLE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book            LibraryBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrows         LibraryBorrowRecord[]

  @@unique([tenantId, accessionNumber])
  @@index([tenantId, bookId, status])
  @@map("library_book_copies")
}

model LibraryBorrowRecord {
  id          String         @id @default(uuid(7))
  tenantId    String         @map("tenant_id")
  copyId      String         @map("copy_id")
  studentId   String         @map("student_id")
  borrowedAt  DateTime       @default(now()) @map("borrowed_at")
  dueDate     DateTime       @map("due_date")
  returnedAt  DateTime?      @map("returned_at")
  renewCount  Int            @default(0) @map("renew_count")
  status      BorrowStatus   @default(ISSUED)
  fineAmount  Float          @default(0) @map("fine_amount")
  finePaid    Boolean        @default(false) @map("fine_paid")
  issuedById  String?        @map("issued_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copy        LibraryBookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy    User?          @relation("BorrowIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, status])
  @@index([tenantId, copyId, status])
  @@map("library_borrow_records")
}

model LibraryReservation {
  id          String            @id @default(uuid(7))
  tenantId    String            @map("tenant_id")
  bookId      String            @map("book_id")
  studentId   String            @map("student_id")
  reservedAt  DateTime          @default(now()) @map("reserved_at")
  expiresAt   DateTime          @map("expires_at")
  status      ReservationStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book        LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student     StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, bookId, status])
  @@index([tenantId, studentId, status])
  @@map("library_reservations")
}

model LibraryEbookAccess {
  id                  String         @id @default(uuid(7))
  tenantId            String         @map("tenant_id")
  bookId              String         @map("book_id")
  studentId           String         @map("student_id")
  lastPageRead        Int            @default(1) @map("last_page_read")
  totalReadingMinutes Int            @default(0) @map("total_reading_minutes")
  lastAccessedAt      DateTime       @default(now()) @map("last_accessed_at")

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book                LibraryBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bookId, studentId])
  @@index([tenantId, studentId])
  @@map("library_ebook_accesses")
}

// ==============================================================================
// RANK 10: Study Hub System (Courses, Materials, Assignments & Peer Grading)
// ==============================================================================

enum StudyMaterialType {
  NOTE
  SLIDE
  LAB_MANUAL
  RECORDING
  SAMPLE_PAPER
}

enum StudyAssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum StudySubmissionStatus {
  SUBMITTED
  GRADED
  LATE
  REJECTED
}

model StudyCourse {
  id           String            @id @default(uuid(7))
  tenantId     String            @map("tenant_id")
  code         String            // e.g. "CS-301"
  title        String            // e.g. "Advanced Operating Systems"
  description  String?
  department   String
  credits      Int               @default(4)
  semester     Int               @default(1)
  instructorId String?           @map("instructor_id")
  syllabusText String?           @map("syllabus_text")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instructor   User?             @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  materials    StudyMaterial[]
  assignments  StudyAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, department, semester])
  @@map("study_courses")
}

model StudyMaterial {
  id           String            @id @default(uuid(7))
  tenantId     String            @map("tenant_id")
  courseId     String            @map("course_id")
  title        String
  description  String?
  unitNumber   Int               @default(1) @map("unit_number")
  materialType StudyMaterialType @default(NOTE) @map("material_type")
  fileUrl      String            @map("file_url")
  fileSizeBytes BigInt           @default(0) @map("file_size_bytes")
  publishedAt  DateTime          @default(now()) @map("published_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course       StudyCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([tenantId, courseId, unitNumber])
  @@map("study_materials")
}

model StudyAssignment {
  id                       String                @id @default(uuid(7))
  tenantId                 String                @map("tenant_id")
  courseId                 String                @map("course_id")
  title                    String
  description              String
  maxMarks                 Int                   @default(100) @map("max_marks")
  dueDate                  DateTime              @map("due_date")
  allowLateSubmission      Boolean               @default(true) @map("allow_late_submission")
  latePenaltyPercentPerDay Int                   @default(5) @map("late_penalty_percent_per_day")
  status                   StudyAssignmentStatus @default(DRAFT)
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course                   StudyCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions              StudySubmission[]

  @@index([tenantId, courseId, status])
  @@map("study_assignments")
}

model StudySubmission {
  id            String                @id @default(uuid(7))
  tenantId      String                @map("tenant_id")
  assignmentId  String                @map("assignment_id")
  studentId     String                @map("student_id")
  fileUrl       String?               @map("file_url")
  contentText   String?               @map("content_text")
  submittedAt   DateTime              @default(now()) @map("submitted_at")
  status        StudySubmissionStatus @default(SUBMITTED)
  marksObtained Float?                @map("marks_obtained")
  feedback      String?
  gradedById    String?               @map("graded_by_id")
  gradedAt      DateTime?             @map("graded_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment    StudyAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy      User?                 @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  peerReviews   StudyPeerReview[]

  @@unique([assignmentId, studentId])
  @@index([tenantId, assignmentId, status])
  @@index([tenantId, studentId])
  @@map("study_submissions")
}

model StudyPeerReview {
  id                String          @id @default(uuid(7))
  submissionId      String          @map("submission_id")
  reviewerStudentId String          @map("reviewer_student_id")
  score             Float
  comments          String
  reviewedAt        DateTime        @default(now()) @map("reviewed_at")

  submission        StudySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer          StudentProfile  @relation("PeerReviewer", fields: [reviewerStudentId], references: [id], onDelete: Cascade)

  @@unique([submissionId, reviewerStudentId])
  @@index([reviewerStudentId])
  @@map("study_peer_reviews")
}

// ==============================================================================
// RANK 11: Progress Tracker & Mentorship System
// ==============================================================================

enum MentorAllocationStatus {
  ACTIVE
  COMPLETED
  REASSIGNED
}

enum MentorshipMeetingType {
  ONE_ON_ONE
  GROUP
  ACADEMIC_REVIEW
  EMERGENCY_COUNSELING
}

enum MentorshipSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AtRiskStatus {
  NORMAL
  WATCHLIST
  CRITICAL_INTERVENTION
}

enum AtRiskType {
  ACADEMIC_PROBATION
  ATTENDANCE_SHORTAGE
  DISCIPLINARY
  MENTAL_HEALTH
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MentorAllocation {
  id            String                 @id @default(uuid(7))
  tenantId      String                 @map("tenant_id")
  studentId     String                 @map("student_id")
  mentorStaffId String                 @map("mentor_staff_id")
  cohortId      String?                @map("cohort_id")
  status        MentorAllocationStatus @default(ACTIVE)
  allocatedAt   DateTime               @default(now()) @map("allocated_at")
  completedAt   DateTime?              @map("completed_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentor        StaffProfile           @relation(fields: [mentorStaffId], references: [id], onDelete: Cascade)
  sessions      MentorshipSession[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, mentorStaffId, status])
  @@map("mentor_allocations")
}

model MentorshipSession {
  id                String                  @id @default(uuid(7))
  tenantId          String                  @map("tenant_id")
  allocationId      String                  @map("allocation_id")
  scheduledAt       DateTime                @map("scheduled_at")
  completedAt       DateTime?               @map("completed_at")
  location          String?
  meetingType       MentorshipMeetingType   @default(ONE_ON_ONE) @map("meeting_type")
  status            MentorshipSessionStatus @default(SCHEDULED)
  discussionSummary String?                 @map("discussion_summary")
  actionItems       String?                 @map("action_items")
  followUpDate      DateTime?               @map("follow_up_date")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocation        MentorAllocation        @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([tenantId, allocationId, status])
  @@map("mentorship_sessions")
}

model StudentAcademicProgress {
  id                   String       @id @default(uuid(7))
  tenantId             String       @map("tenant_id")
  studentId            String       @map("student_id")
  semester             Int
  sgpa                 Float
  cgpa                 Float
  attendancePercentage Float        @map("attendance_percentage")
  creditsEarned        Int          @map("credits_earned")
  totalCredits         Int          @map("total_credits")
  atRiskStatus         AtRiskStatus @default(NORMAL) @map("at_risk_status")
  remarks              String?
  evaluatedAt          DateTime     @default(now()) @map("evaluated_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, semester])
  @@index([tenantId, atRiskStatus])
  @@map("student_academic_progress")
}

model MentorshipAtRiskAlert {
  id           String       @id @default(uuid(7))
  tenantId     String       @map("tenant_id")
  studentId    String       @map("student_id")
  riskType     AtRiskType   @map("risk_type")
  severity     RiskSeverity @default(MEDIUM)
  description  String
  resolvedAt   DateTime?    @map("resolved_at")
  resolvedById String?      @map("resolved_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, severity])
  @@map("mentorship_at_risk_alerts")
}








